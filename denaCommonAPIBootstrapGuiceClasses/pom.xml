<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- ====================================================================== -->
	<!-- PARENT                                                                 -->
	<!-- ====================================================================== -->
	<parent>
		<groupId>dena.api.common</groupId>
		<artifactId>denaCommonAPI</artifactId>
		<version>${revision}</version>
		<relativePath>../pom.xml</relativePath>
	</parent>


	<!-- ====================================================================== -->
	<!-- ARTIFACT                                                               -->
	<!-- ====================================================================== -->
	<name>denaCommonAPIBootstrapGuiceClasses</name>
	<artifactId>denaCommonAPIBootstrapGuiceClasses</artifactId>
	<packaging>jar</packaging>

	<!-- ====================================================================== -->
	<!-- DEPENDENCIES                                                           -->
	<!-- ====================================================================== -->
	<dependencies>
		<!-- ///////////////////////////////////////// -->
		<!-- R01F: ObjectsStreamer                     -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
			<groupId>r01.fabric.base.objectstreamer</groupId>
			<artifactId>r01fObjectStreamerClasses</artifactId>
			<version>${r01f.base.version}</version>
		</dependency>
		<!-- ///////////////////////////////////////// -->
		<!-- R01F: Business Services Guice             -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
			<groupId>r01.fabric.businessservices.guice</groupId>
			<artifactId>r01fBusinessServicesGuiceClasses</artifactId>
			<version>${r01f.businessservices.version}</version>
		</dependency>
		<!-- ///////////////////////////////////////// -->
		<!--  DENA Common: API                         -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
			<groupId>dena.api.common</groupId>
			<artifactId>denaCommonAPIClasses</artifactId>
			<version>${revision}</version>
		</dependency>
    </dependencies>

	<!-- ====================================================================== -->
	<!-- BUILD                                                                  -->
	<!-- ====================================================================== -->
	<build>
		<pluginManagement>
			<plugins>
				<!--
				ECLIPSE (see main pom.xml for further info) ===================
				This plugin has NO effects in maven build:
					m2e ONLY runs some 'standard' goals of the maven pom.xml since the aim of m2e is NOT to be a
				complete CI tool
					... in order to include 'non-standard' goals in m2e execution and avoid [plugin execution not
				covered by the eclipse m2e plugin project build lifecycle mapping]
						the 'non-standard' plugin MUST be explicitly included in m2e execution
				-->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<!-- flatten plugin -->
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.codehaus.mojo</groupId>
										<artifactId>flatten-maven-plugin</artifactId>
										<versionRange>[1.1.0,)</versionRange>
										<goals>
											<goal>flatten</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
